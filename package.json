{
  "name": "xaendar",
  "version": "0.9.30",
  "author": "Kaitenjo",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build:projects": "npm run build-projects --prefix schematics",
    "build:schematics": "npm run build --prefix schematics",
    "build:schematics:watch": "npm run build:watch --prefix schematics",
    "build:src": "vite build",
    "build:watch:extension": "npm run build:watch:extension --prefix schematics",
    "check:dependencies": "npm run check-dependencies --prefix schematics",
    "deploy": "npm run build:schematics && npm run check:dependencies && npm run typecheck:projects && npm run update:version && npm run build:projects && npm run pack:projects && npm run publish:projects && npm i",
    "i": "npm i --omit-optional --ignore-scripts",
    "install:clean": "rimraf package-lock.json node_modules && npm run i",
    "pack:projects": "npm run pack --prefix schematics",
    "publish:projects": "npm run publish --prefix schematics",
    "start:node": "nodemon --watch src --watch packages -e ts --exec \"node --inspect-brk --import tsx/esm src/test.ts\"",
    "start:browser": "vite",
    "test:debug": "node --inspect-brk ./node_modules/.bin/vitest run signals",
    "typecheck:projects": "npm run typecheck-projects --prefix schematics",
    "update:version": "npm run update-version --prefix schematics",
    "xd": "node dist/@xaendar/cli/dist/cli.js new backoffice --style css"
  },
  "dependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "typescript": "^6.0.3",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@types/convert-source-map": "^2.0.3",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.134.0",
    "@vitest/coverage-v8": "^4.1.11",
    "depcheck": "^1.4.7",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "type-fest": "^5.9.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.9.0"
  }
}
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:watch:extension",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:watch:extension"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "tsup",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^ERROR\\s+(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^CLI Building entry",
          "endsPattern": "^CJS ⚡️ Build success"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}